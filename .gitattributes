# Line endings: LF in the repository AND in every working tree, on every platform.
# .editorconfig sets `end_of_line = lf` and CI runs `dotnet format --verify-no-changes`
# on Linux and Windows, so Windows checkouts must not be converted to CRLF.
* text=auto eol=lf

# Verify snapshot files: LF and UTF-8 on every platform (covered by the default above,
# kept explicit because snapshot comparisons depend on it)
*.verified.txt  text eol=lf working-tree-encoding=UTF-8
*.verified.xml  text eol=lf working-tree-encoding=UTF-8
*.verified.json text eol=lf working-tree-encoding=UTF-8
*.verified.cs   text eol=lf working-tree-encoding=UTF-8

# cmd.exe batch files are the one exception: they can misbehave with LF (labels, goto).
# PowerShell scripts (.ps1) work with LF and follow the default.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Diff drivers
*.cs  diff=csharp
*.md  diff=markdown

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.zip    binary
*.snk    binary
*.dll    binary
*.exe    binary
*.pdb    binary
*.nupkg  binary
*.snupkg binary
