<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Guacamole.Core</PackageId>
    <PackageVersion>0.1.0-alpha</PackageVersion>
    <PackageDescription>Core incremental computation engine for the Guacamole framework. Foundation framework for incremental compilers, powering the Fugu language compiler and similar tooling.</PackageDescription>
    <PackageProjectUrl>https://github.com/pekkah/guacamole</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>incremental;computation;compiler;framework;roslyn</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors />
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Guacamole.Core.Tests" />
  </ItemGroup>

</Project>