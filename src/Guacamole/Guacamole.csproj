<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Guacamole</PackageId>
    <Description>Foundation framework for incremental compilers, powering the Fugu language compiler and similar tooling. Note: Source generators are in a separate Guacamole.SourceGenerators package.</Description>
    <PackageTags>incremental;query;engine;compiler;framework</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors />
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Guacamole.Tests" />
    <InternalsVisibleTo Include="Guacamole.SourceGenerators.Tests" />
  </ItemGroup>

</Project>