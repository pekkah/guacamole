<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Guacamole</PackageId>
    <Description>Foundation framework for incremental compilers, powering the Fugu language compiler and similar tooling. Note: Source generators are in a separate Guacamole.SourceGenerators package.</Description>
    <PackageTags>incremental;query;engine;compiler;framework</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0-rc.1.25451.107" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include Guacamole.Core as a package dependency -->
    <ProjectReference Include="..\Guacamole.Core\Guacamole.Core.csproj" />
  </ItemGroup>

</Project>