<Project>
  <PropertyGroup>
    <!-- Target framework consistency -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>

    <!-- Package metadata (synchronized across all packages) -->
    <Authors>Pekka Heikura</Authors>
    <Company>Guacamole</Company>
    <Product>Guacamole Framework</Product>
    <Description>Foundation framework for incremental compilers, powering the Fugu language compiler and similar tooling</Description>
    <Copyright>Copyright © 2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pekkah/guacamole</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>incremental;query;engine;source-generators;compiler;framework</PackageTags>
    <RepositoryUrl>https://github.com/pekkah/guacamole</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Simple static versioning (GitVersion removed for cross-platform compatibility) -->
    <Version>0.1.0-dev</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- Output directories -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Symbol packages -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Source link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Common package references -->
  <ItemGroup>
    <!-- <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/> -->
  </ItemGroup>

  <!-- Include README in packages -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
