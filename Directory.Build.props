<Project>
  <PropertyGroup>
    <!-- Target framework consistency -->
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>

    <!-- Package metadata (synchronized across all packages) -->
    <Authors>Pekka Heikura</Authors>
    <Company>Guacamole</Company>
    <Product>Guacamole Framework</Product>
    <Description>Foundation framework for incremental compilers, powering the Fugu language compiler and similar tooling</Description>
    <Copyright>Copyright © 2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pekkah/guacamole</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>incremental;query;engine;source-generators;compiler;framework;roslyn;incremental-computation;dependency-injection;caching</PackageTags>
    <RepositoryUrl>https://github.com/pekkah/guacamole</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Versioning: local builds default to 0.1.0-dev. CI (.github/workflows/ci.yml) computes the
         real version (GitVersion SemVer, or the v* tag name for releases; see GitVersion.yml and
         docs/ci-cd.md) and overrides this with -p:Version=... at pack time. -->
    <Version>0.1.0-dev</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- Output directories -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Symbol packages -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Source link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Package validation -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Uncomment after first 0.1.0 release:
    <PackageValidationBaselineVersion>0.1.0</PackageValidationBaselineVersion>
    -->
  </PropertyGroup>

  <!-- Common package references -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All"/>
  </ItemGroup>

  <!-- Include README in packages -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
